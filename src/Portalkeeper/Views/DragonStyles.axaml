<!-- Evermore fork: DragonUI's look for the launcher's window and its pages (DragonUI.cs). Included by
     the main window's Styles: buttons become DragonUI's red buttons, except the ones with a look of
     their own (link, chrome, gold, plain), "inset" buttons are a filigree frame over marble, and
     PageBanner is a page's header strip. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Portalkeeper.Views">

    <Style Selector="Button:not(.link):not(.chrome):not(.gold):not(.plain):not(.inset)">
        <Setter Property="Foreground" Value="#FFD100" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <views:RedButtonChrome />
                    <ContentPresenter Name="DragonContent"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button:not(.link):not(.chrome):not(.gold):not(.plain):not(.inset):pointerover">
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button:not(.link):not(.chrome):not(.gold):not(.plain):not(.inset):disabled">
        <Setter Property="Foreground" Value="#8A8A8A" />
    </Style>

    <Style Selector="Button.inset">
        <Setter Property="Foreground" Value="#D8CCBA" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <views:DragonFrame Kind="SmallInset" Ground="Marble" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="DragonContent"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </views:DragonFrame>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.inset:pointerover /template/ ContentPresenter#DragonContent">
        <Setter Property="Background" Value="#14FFE9A8" />
    </Style>

    <!-- A window's header title: Cinzel in the main window logo's gold -->
    <Style Selector="TextBlock.dragon-title">
        <Setter Property="FontFamily" Value="avares://Portalkeeper/Assets/Fonts#Cinzel" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="1.5" />
        <Setter Property="Foreground">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#FFF4CC" />
                <GradientStop Offset="0.5" Color="#E8B64C" />
                <GradientStop Offset="1" Color="#9C6B1E" />
            </LinearGradientBrush>
        </Setter>
        <Setter Property="Effect">
            <DropShadowEffect Color="#88E8B64C" BlurRadius="14" OffsetX="0" OffsetY="0" />
        </Setter>
    </Style>
    <!-- The small "PORTALKEEPER" mark at the header's right, and the line under it -->
    <Style Selector="TextBlock.dragon-brand">
        <Setter Property="FontFamily" Value="avares://Portalkeeper/Assets/Fonts#Cinzel" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="2" />
        <Setter Property="Foreground" Value="#D8CCBA" />
    </Style>
    <Style Selector="TextBlock.dragon-tagline">
        <Setter Property="LetterSpacing" Value="1" />
        <Setter Property="Foreground" Value="#8C8273" />
    </Style>

    <!-- A page's header strip (PageBanner): the realm skyline, the page's name and line, and the
         page's own controls at the right. -->
    <Style Selector="views|PageBanner">
        <Setter Property="Height" Value="76" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border BorderBrush="#9A6D25" BorderThickness="0,0,0,2" ClipToBounds="True">
                    <Grid>
                        <Image Source="avares://Portalkeeper/Assets/Calendar/header-banner.png" Stretch="UniformToFill" Opacity="0.8" />
                        <Border Background="#77030A10" />
                        <Grid Margin="26,0,22,0" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <TextBlock Classes="dragon-title" Text="{TemplateBinding Title}" FontSize="24" />
                                <TextBlock Text="{TemplateBinding Subtitle}" FontSize="12" Foreground="#D8C9A7" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Check boxes in DragonUI's gold rather than the system accent -->
    <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="#3A2A14" />
        <Setter Property="BorderBrush" Value="#E8B64C" />
    </Style>
    <Style Selector="CheckBox:checked:pointerover /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="#4A3518" />
        <Setter Property="BorderBrush" Value="#FFD100" />
    </Style>
    <Style Selector="CheckBox:checked /template/ Path#CheckGlyph">
        <Setter Property="Fill" Value="#FFD100" />
    </Style>
    <Style Selector="CheckBox:unchecked /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="#1A140E" />
        <Setter Property="BorderBrush" Value="#8C6A2E" />
    </Style>

    <!-- Drop-downs: dark with a bronze edge, like DragonUI's -->
    <Style Selector="ComboBox">
        <Setter Property="Background" Value="#1A140E" />
        <Setter Property="BorderBrush" Value="#8C6A2E" />
        <Setter Property="Foreground" Value="#F2E7D0" />
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="#241B12" />
        <Setter Property="BorderBrush" Value="#E8B64C" />
    </Style>
</Styles>
