<!-- Evermore fork: the top bar of a DragonUI window, drawn on the bronze frame's title band like the
     main window's: the window's name, minimize and close. Drag it to move the window; double-click
     maximizes a window that can be resized. The window sets WindowDecorations="BorderOnly" and
     ExtendClientAreaToDecorationsHint so this band replaces the system title bar. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Portalkeeper.Views.DragonTitleBar"
             x:Name="Root"
             Height="48"
             VerticalAlignment="Top">
    <UserControl.Styles>
        <Style Selector="Button.chrome">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Foreground" Value="#D8CCBA" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.chrome:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="Foreground" Value="#FFE9A8" />
        </Style>
        <Style Selector="Button.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#C42B1C" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </UserControl.Styles>

    <Grid Background="Transparent" ColumnDefinitions="*,Auto"
          PointerPressed="Band_PointerPressed">
        <TextBlock Text="{Binding Title, ElementName=Root}"
                   Margin="24,0,0,0"
                   VerticalAlignment="Center"
                   FontFamily="avares://Portalkeeper/Assets/Fonts#Cinzel"
                   FontSize="13"
                   FontWeight="SemiBold"
                   LetterSpacing="1"
                   Foreground="#D8CCBA"
                   IsHitTestVisible="False" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0">
            <Button Classes="chrome" Content="—" Click="Minimize_Click" ToolTip.Tip="Minimize"
                    IsVisible="{Binding ShowMinimize, ElementName=Root}" />
            <Button Classes="chrome close" Content="✕" Click="Close_Click" ToolTip.Tip="Close" />
        </StackPanel>
    </Grid>
</UserControl>
