<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Portalkeeper.ViewModels"
    xmlns:views="using:Portalkeeper.Views"
    mc:Ignorable="d"
    d:DesignWidth="1100"
    d:DesignHeight="660"
    x:Class="Portalkeeper.Views.MainWindow"
    x:DataType="vm:MainViewModel"
    Title="Evermore"
    Width="1100"
    Height="660"
    MinWidth="980"
    MinHeight="620"
    WindowDecorations="BorderOnly"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="48"
    Background="#05080D"
    WindowStartupLocation="CenterScreen">

    <!-- Evermore fork: one scene, like a game launcher. Realm, client, addons and sharing details
         live in Settings; required patches and addons look after themselves. -->
    <Window.Styles>
        <StyleInclude Source="avares://Portalkeeper/Views/DragonStyles.axaml" />
        <Style Selector="Button">
            <Setter Property="Background" Value="#CC0B141E" />
            <Setter Property="Foreground" Value="#F6D477" />
            <Setter Property="BorderBrush" Value="#9A6B1E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1B2A38" />
            <Setter Property="BorderBrush" Value="#D2A43A" />
            <Setter Property="Foreground" Value="#FFE9A8" />
        </Style>
        <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#990D1218" />
            <Setter Property="Foreground" Value="#75694E" />
            <Setter Property="BorderBrush" Value="#4E432C" />
        </Style>

        <!-- Top bar links -->
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontFamily" Value="avares://Portalkeeper/Assets/Fonts#Cinzel" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#D8CCBA" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFE9A8" />
        </Style>

        <!-- A line on the home screen that opens a page -->
        <Style Selector="Button.plain">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.plain:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Window buttons -->
        <Style Selector="Button.chrome">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Foreground" Value="#D8CCBA" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.chrome:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#22FFFFFF" />
        </Style>
        <Style Selector="Button.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#C42B1C" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- The big gold button -->
        <Style Selector="Button.gold">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#F6D17A" />
                    <GradientStop Offset="0.55" Color="#D9A53E" />
                    <GradientStop Offset="1" Color="#B07C22" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush" Value="#FFE6A3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="#2A1A05" />
        </Style>
        <Style Selector="Button.gold:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#FFE29A" />
                    <GradientStop Offset="0.55" Color="#E8B650" />
                    <GradientStop Offset="1" Color="#C08A2C" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush" Value="#FFF2C8" />
            <Setter Property="Foreground" Value="#2A1A05" />
        </Style>
        <Style Selector="Button.gold:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#3A3020" />
            <Setter Property="BorderBrush" Value="#6E5A30" />
            <Setter Property="Foreground" Value="#A8946A" />
        </Style>

        <Style Selector="TextBlock.serif">
            <Setter Property="FontFamily" Value="avares://Portalkeeper/Assets/Fonts#Cinzel" />
        </Style>
    </Window.Styles>

    <Grid>
        <!-- Background: DragonUI's rock ground (as in Settings) lit warm behind the logo and the
             ENTER REALM button, so the scene matches the bronze frame. Drop Assets/Branding/background.jpg
             in to replace it. -->
        <Border Background="#16110D">
            <Border.Background>
                <ImageBrush Source="/Assets/DragonUI/ground-rock.png" TileMode="Tile" Stretch="Fill"
                            DestinationRect="0,0,256,256" />
            </Border.Background>
        </Border>
        <Border>
            <Border.Background>
                <RadialGradientBrush Center="24%,24%" GradientOrigin="24%,24%" RadiusX="55%" RadiusY="65%">
                    <GradientStop Offset="0" Color="#38C8912C" />
                    <GradientStop Offset="1" Color="#00C8912C" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <Border>
            <Border.Background>
                <RadialGradientBrush Center="82%,85%" GradientOrigin="82%,85%" RadiusX="50%" RadiusY="60%">
                    <GradientStop Offset="0" Color="#26C8912C" />
                    <GradientStop Offset="1" Color="#00C8912C" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <Image x:Name="BackgroundImage" Stretch="UniformToFill" IsVisible="False" />
        <!-- Darken the edges and the bottom so text stays readable on any background. -->
        <Border>
            <Border.Background>
                <RadialGradientBrush Center="50%,45%" GradientOrigin="50%,45%" RadiusX="75%" RadiusY="75%">
                    <GradientStop Offset="0.55" Color="#00000000" />
                    <GradientStop Offset="1" Color="#B0000000" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,55%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#00040709" />
                    <GradientStop Offset="1" Color="#E6040709" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- DragonUI's bronze window frame; its title band is the top bar. -->
        <views:DragonFrame Kind="Bronze" Ground="None" Scale="1.6" IsHitTestVisible="False" />

        <Grid RowDefinitions="48,*,Auto,30">

            <!-- Top bar: drag to move -->
            <Grid Grid.Row="0" Background="Transparent" ColumnDefinitions="*,Auto"
                  PointerPressed="TitleBar_PointerPressed">
                <StackPanel Orientation="Horizontal" Margin="22,0,0,0" Spacing="10" VerticalAlignment="Center">
                    <Button Classes="link" Content="WEBSITE" Click="Website_Click" />
                    <TextBlock Text="|" Foreground="#55D8CCBA" VerticalAlignment="Center" IsVisible="{Binding ArmoryAvailable}" />
                    <Button Classes="link" Content="ARMORY" Click="Armory_Click" IsVisible="{Binding ArmoryAvailable}" />
                    <TextBlock Text="|" Foreground="#55D8CCBA" VerticalAlignment="Center" IsVisible="{Binding ShopAvailable}" />
                    <Button Classes="link" Content="SHOP" Click="Shop_Click" IsVisible="{Binding ShopAvailable}" />
                    <TextBlock Text="|" Foreground="#55D8CCBA" VerticalAlignment="Center" />
                    <Button Classes="link" Content="PATCH NOTES" Click="PatchNotes_Click" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0">
                    <Button Classes="chrome" Content="—" Click="Minimize_Click" ToolTip.Tip="Minimize" />
                    <Button Classes="chrome close" Content="✕" Click="Close_Click" ToolTip.Tip="Close" />
                </StackPanel>
            </Grid>

            <!-- Logo and realm status -->
            <Grid Grid.Row="1" Margin="40,26,32,0" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Top" Spacing="2">
                    <TextBlock Classes="serif"
                               Text="{Binding LauncherTitle}"
                               FontSize="68"
                               FontWeight="Bold"
                               LetterSpacing="2">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                <GradientStop Offset="0" Color="#FFF4CC" />
                                <GradientStop Offset="0.5" Color="#E8B64C" />
                                <GradientStop Offset="1" Color="#9C6B1E" />
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#AAE8B64C" BlurRadius="24" OffsetX="0" OffsetY="0" />
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Classes="serif"
                               Text="{Binding RealmDescription}"
                               Margin="6,0,0,0"
                               FontSize="16"
                               LetterSpacing="4"
                               Foreground="#D8CCBA" />
                </StackPanel>

                <!-- Realm status, what's going on, what's new -->
                <Grid Grid.Column="1" Width="400" Margin="0,0,0,12" RowDefinitions="Auto,Auto,*" RowSpacing="10">
                    <Button Classes="inset"
                            HorizontalAlignment="Right"
                            Click="RealmCheckAgain_Click"
                            ToolTip.Tip="{Binding RealmStatus}"
                            Padding="16,9">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <TextBlock Text="Realm status" Foreground="#D8CCBA" FontWeight="Normal" VerticalAlignment="Center" />
                            <Ellipse Width="9" Height="9" Fill="{Binding RealmStatusBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding RealmStatusText}" Foreground="{Binding RealmStatusBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <views:DragonFrame Grid.Row="1" IsVisible="{Binding HasLiveInfo}" Ground="Marble" Padding="18,12">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasLivePlayers}">
                                <Ellipse Width="7" Height="7" Fill="#3DDC84" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LivePlayersText}" Foreground="#D8CCBA" FontSize="12" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasLiveRestart}">
                                <Ellipse Width="7" Height="7" Fill="{Binding LiveRestartBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LiveRestartText}" Foreground="{Binding LiveRestartBrush}" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasLiveEvents}">
                                <Ellipse Width="7" Height="7" Fill="#E8B64C" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LiveEventsText}" Foreground="#D8CCBA" FontSize="12"
                                           TextTrimming="CharacterEllipsis" MaxWidth="310" />
                            </StackPanel>
                            <Button Classes="plain" Click="RareMap_Click" IsVisible="{Binding HasLiveBosses}"
                                    ToolTip.Tip="Open the rare map">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="7" Height="7" Fill="#E5604D" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding LiveBossesText}" Foreground="#D8CCBA" FontSize="12" FontWeight="Normal" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </views:DragonFrame>

                    <views:DragonFrame Grid.Row="2" IsVisible="{Binding HasWhatsNew}" VerticalAlignment="Top" Ground="Marble" Padding="18,14">
                        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                            <TextBlock Text="{Binding WhatsNewTitle}" Foreground="#E8B64C" FontSize="11" FontWeight="Bold" LetterSpacing="1" />
                            <TextBlock Grid.Row="1" Text="{Binding WhatsNewEmptyText}" IsVisible="{Binding !HasWhatsNewItems}"
                                       Foreground="#AFA28D" FontSize="12" />
                            <ScrollViewer Grid.Row="1" IsVisible="{Binding HasWhatsNewItems}" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding WhatsNewItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="14" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:WhatsNewItem">
                                            <!-- The tag sits above the text so every headline starts at the same edge;
                                                 the right margin keeps the text clear of the scroll bar. -->
                                            <StackPanel Spacing="3" Margin="0,0,16,0">
                                                <TextBlock Text="{Binding Tag}" Foreground="{Binding TagBrush}" FontSize="9" FontWeight="Bold" LetterSpacing="0.5" />
                                                <TextBlock Text="{Binding Headline}" Foreground="#F2E7D0" FontSize="12" LineHeight="17"
                                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                           Foreground="#AFA28D" FontSize="11"
                                                           MaxLines="1" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
                                <Button Classes="link" Content="ALL PATCH NOTES" Click="WhatsNew_Click" Padding="0" FontSize="11" />
                                <TextBlock Text="{Binding WhatsNewMoreText}" Foreground="#8C8273" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </views:DragonFrame>
                </Grid>
            </Grid>

            <!-- Status card, settings, enter realm -->
            <Grid Grid.Row="2" Margin="32,0,32,10" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
                <StackPanel VerticalAlignment="Bottom" Spacing="8">
                    <!-- Launcher update -->
                    <views:DragonFrame IsVisible="{Binding IsUpdateAvailable}" Ground="Marble" Padding="14,8">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding AvailableReleaseText}" Foreground="#F6D477" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding UpdateReadyText}" IsVisible="{Binding IsUpdateReady}" Foreground="#AFA28D" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="UPDATE NOW" Click="UpdateNow_Click" IsVisible="{Binding IsUpdateReady}" Padding="12,6" />
                            <Button Grid.Column="2" Content="DETAILS" Click="ViewRelease_Click" Padding="12,6" />
                        </Grid>
                    </views:DragonFrame>

                    <!-- The game crashed -->
                    <views:DragonFrame IsVisible="{Binding HasCrashBanner}" Ground="Marble" Padding="14,8">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="World of Warcraft crashed" Foreground="#F2B84B" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CrashBannerSummary}" IsVisible="{Binding HasCrashBannerSummary}"
                                           Foreground="#D8CCBA" FontSize="11" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding CrashBannerDetail}" Foreground="#AFA28D" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="SEND REPORT" Click="SendCrashReport_Click" IsVisible="{Binding CanSendCrashReport}" Padding="12,6" />
                            <Button Grid.Column="2" Content="ALWAYS SEND" Click="AlwaysSendCrashReports_Click" IsVisible="{Binding CrashBannerOffersAlways}" Padding="12,6"
                                    ToolTip.Tip="Send crash reports without asking from now on (Settings can turn it off)" />
                            <Button Grid.Column="3" Content="REPAIR GAME" Click="RepairGame_Click" IsVisible="{Binding CrashBannerOffersRepair}"
                                    IsEnabled="{Binding CanRepairGame}" Padding="12,6" />
                            <Button Grid.Column="4" Classes="chrome" Width="32" Height="32" Content="✕" Click="DismissCrash_Click" ToolTip.Tip="Dismiss" />
                        </Grid>
                    </views:DragonFrame>

                    <views:DragonFrame Ground="Marble" Padding="18,14" MinHeight="96">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                            <Border Width="44" Height="44" CornerRadius="22" BorderThickness="2"
                                    BorderBrush="{Binding CardIconBrush}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CardIcon}" Foreground="{Binding CardIconBrush}"
                                           FontSize="20" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <TextBlock Text="{Binding CardTitle}" FontSize="17" FontWeight="SemiBold" Foreground="{Binding CardIconBrush}" />
                                <TextBlock Text="{Binding CardDetail}" FontSize="12" Foreground="#D8CCBA" TextWrapping="Wrap" MaxHeight="48" />
                                <ProgressBar Margin="0,4,0,0" Height="5" Minimum="0" Maximum="100"
                                             Value="{Binding InstallPercent}" Foreground="#E8B64C" Background="#26FFFFFF"
                                             IsVisible="{Binding CardIsInstalling}" />
                                <ProgressBar Margin="0,4,0,0" Height="3" IsIndeterminate="True"
                                             Foreground="#E8B64C" Background="#26FFFFFF"
                                             IsVisible="{Binding CardIsSyncing}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <!-- No client yet -->
                                <Button Content="{Binding InstallClientButtonText}" Click="InstallClient_Click"
                                        IsVisible="{Binding CanInstallClient}" Padding="16,9" />
                                <Button Content="INSTALL ELSEWHERE" Click="InstallElsewhere_Click"
                                        IsVisible="{Binding CanInstallElsewhere}" Padding="12,9" />
                                <Button Content="LOCATE" Click="LocateClient_Click"
                                        IsVisible="{Binding CardIsNoClient}" Padding="16,9"
                                        ToolTip.Tip="Use a World of Warcraft 3.3.5a client you already have" />
                                <!-- Downloading -->
                                <Button Content="PAUSE" Click="CancelInstall_Click"
                                        IsVisible="{Binding CardIsInstalling}" Padding="16,9" />
                                <!-- Ready / needs attention -->
                                <Button Content="CHECK FILES" Click="RealmCheckAgain_Click"
                                        IsVisible="{Binding CardIsReady}" Padding="16,9"
                                        ToolTip.Tip="Check the realm for updates and verify patches and addons" />
                                <Button Content="TRY AGAIN" Click="RealmCheckAgain_Click"
                                        IsVisible="{Binding CardIsAttention}" Padding="16,9" />
                            </StackPanel>
                        </Grid>
                    </views:DragonFrame>
                </StackPanel>

                <Button Grid.Column="1" Classes="inset" Width="72" Height="96" VerticalAlignment="Bottom"
                        Click="Settings_Click" ToolTip.Tip="Settings: client, addons, sharing, account"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <!-- Drawn rather than the ⚙ character, which each OS draws from a different font. -->
                    <Path Width="30" Height="30" Stretch="Uniform" Fill="#E8B64C"
                          Data="F0 M 19.84,9.60 L 22.37,10.36 L 22.37,13.64 L 19.84,14.40 L 19.24,15.85 L 20.49,18.17 L 18.17,20.49 L 15.85,19.24 L 14.40,19.84 L 13.64,22.37 L 10.36,22.37 L 9.60,19.84 L 8.15,19.24 L 5.83,20.49 L 3.51,18.17 L 4.76,15.85 L 4.16,14.40 L 1.63,13.64 L 1.63,10.36 L 4.16,9.60 L 4.76,8.15 L 3.51,5.83 L 5.83,3.51 L 8.15,4.76 L 9.60,4.16 L 10.36,1.63 L 13.64,1.63 L 14.40,4.16 L 15.85,4.76 L 18.17,3.51 L 20.49,5.83 L 19.24,8.15 Z M 15.40,12 A 3.4,3.4 0 1 0 8.60,12 A 3.4,3.4 0 1 0 15.40,12 Z" />
                </Button>

                <Button Grid.Column="2" Classes="gold" Width="300" Height="96" VerticalAlignment="Bottom"
                        IsEnabled="{Binding CanEnterRealm}" Click="EnterRealm_Click"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Button.Effect>
                        <DropShadowEffect Color="#66E8B64C" BlurRadius="22" OffsetX="0" OffsetY="0" />
                    </Button.Effect>
                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                        <TextBlock Classes="serif" Text="{Binding EnterRealmButtonText}" FontSize="26" FontWeight="Bold"
                                   LetterSpacing="2" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding EnterRealmSubText}" FontSize="12" FontWeight="Normal" HorizontalAlignment="Center"
                                   IsVisible="{Binding EnterRealmSubText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="3" Margin="34,0,34,12" ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FooterText}" Foreground="#8C8273" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CombatLogStatus}" IsVisible="{Binding HasCombatLogStatus}"
                               Foreground="#E8B64C" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding AccountSummary}" Foreground="#8C8273" FontSize="11" VerticalAlignment="Center" />
            </Grid>
        </Grid>

        <!-- Login: the launcher is used with the player's game account -->
        <Grid Background="#E6040709" IsVisible="{Binding ShowLogin}">
            <Grid RowDefinitions="48,*">
                <Grid Background="Transparent" ColumnDefinitions="*,Auto" PointerPressed="TitleBar_PointerPressed">
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0">
                        <Button Classes="chrome" Content="—" Click="Minimize_Click" ToolTip.Tip="Minimize" />
                        <Button Classes="chrome close" Content="✕" Click="Close_Click" ToolTip.Tip="Close" />
                    </StackPanel>
                </Grid>
                <views:DragonFrame Grid.Row="1" Width="420"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Ground="Marble"
                        Padding="30,26">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="serif" Text="{Binding LauncherTitle}" HorizontalAlignment="Center"
                                   FontSize="40" FontWeight="Bold" LetterSpacing="2">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                    <GradientStop Offset="0" Color="#FFF4CC" />
                                    <GradientStop Offset="0.5" Color="#E8B64C" />
                                    <GradientStop Offset="1" Color="#9C6B1E" />
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                        <TextBlock Text="Log in with your game account. Portalkeeper keeps you logged in for 30 days and signs you in to the game."
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="#AFA28D" />
                        <TextBox x:Name="AccountNameBox"
                                 Text="{Binding RememberedAccountName, Mode=OneWay}"
                                 PlaceholderText="Account name"
                                 KeyDown="LoginField_KeyDown" />
                        <TextBox x:Name="PasswordBox"
                                 PlaceholderText="Password"
                                 PasswordChar="•"
                                 KeyDown="LoginField_KeyDown" />
                        <TextBlock Text="{Binding LoginError}"
                                   IsVisible="{Binding HasLoginError}"
                                   Foreground="#E58A73"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding LoginStatus}"
                                   Foreground="#AFA28D"
                                   HorizontalAlignment="Center" />
                        <Button Classes="gold"
                                IsEnabled="{Binding CanLogIn}"
                                Click="LogIn_Click"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="18,12">
                            <TextBlock Classes="serif" Text="LOG IN" FontSize="17" FontWeight="Bold" LetterSpacing="2" />
                        </Button>
                        <Button Content="CREATE AN ACCOUNT"
                                Click="CreateAccount_Click"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="18,8" />
                    </StackPanel>
                </views:DragonFrame>
            </Grid>
        </Grid>

    </Grid>
</Window>
