<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Portalkeeper.ViewModels"
    xmlns:views="using:Portalkeeper.Views"
    x:Class="Portalkeeper.Views.SettingsWindow"
    x:DataType="vm:MainViewModel"
    Width="760"
    Height="560"
    MinWidth="680"
    MinHeight="500"
    Title="Portalkeeper Settings"
    WindowStartupLocation="CenterOwner"
    Background="#091019">

    <Window.Styles>
        <StyleInclude Source="avares://Portalkeeper/Views/DragonStyles.axaml" />
        <Style Selector="Button">
            <Setter Property="Background" Value="#111A24" />
            <Setter Property="Foreground" Value="#F6D477" />
            <Setter Property="BorderBrush" Value="#9A6B1E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#1B2A38" />
            <Setter Property="BorderBrush" Value="#D2A43A" />
            <Setter Property="Foreground" Value="#FFE9A8" />
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="#0C131B" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="#EDE4D2" />
        </Style>
    </Window.Styles>

    <Panel>
    <!-- DragonUI: a rock ground in a bronze frame, sections as marble insets -->
    <views:DragonFrame Kind="Bronze" Ground="Rock" IsHitTestVisible="False" />
    <Grid RowDefinitions="Auto,*,Auto" Margin="6,0,6,6">
        <!-- Shared Portalkeeper cinematic header -->
        <Border Grid.Row="0"
                Background="#0A1119"
                BorderBrush="#A06E1B"
                BorderThickness="0,0,0,2">
            <Grid Height="104" ClipToBounds="True">
                <Image Source="/Assets/Calendar/header-banner.png"
                       Stretch="UniformToFill"
                       Opacity="0.86" />
                <Border Background="#77040A12" />

                <Grid Margin="24,10" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center"
                                Spacing="2">
                        <TextBlock Text="SETTINGS"
                                   Foreground="#FFD96B"
                                   FontSize="25"
                                   FontWeight="Bold" />
                        <TextBlock Text="Client, realm, and launch preferences"
                                   Foreground="#E8DDC8"
                                   FontSize="13" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Spacing="2">
                        <TextBlock Text="PORTALKEEPER"
                                   HorizontalAlignment="Right"
                                   Foreground="#DCCAF2"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="PLAN. PREPARE. PLAY."
                                   HorizontalAlignment="Right"
                                   Foreground="#8F7AA8"
                                   FontSize="9" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="20,18" Spacing="14">
                <!-- Client -->
                <views:DragonFrame Ground="Marble"
                        Padding="16">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Width="42" Height="42"
                                CornerRadius="21"
                                Background="#172330"
                                BorderBrush="#8A6726"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock Text="C"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#F6D477"
                                       FontSize="17"
                                       FontWeight="Bold" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="4">
                            <TextBlock Text="CLIENT"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#D5AA50" />
                            <TextBlock Text="{Binding ClientPath}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#F8F0DF"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ClientStatus}"
                                       FontSize="12"
                                       Foreground="#AFA28D"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding OptionalAddonStatus}"
                                       Margin="0,6,0,0"
                                       FontSize="12"
                                       Foreground="#AFA28D"
                                       TextWrapping="Wrap" />
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="{Binding ClientButtonText}" Click="LocateClient_Click" Margin="0,0,10,0" />
                                <Button Content="MANAGE ADDONS" Click="ManageAddons_Click" IsEnabled="{Binding ClientValid}" Margin="0,0,10,0" />
                                <Button Content="REPAIR GAME" Click="RepairGame_Click" IsEnabled="{Binding CanRepairGame}"
                                        ToolTip.Tip="Clears the cache, reinstalls the realm's addons and checks every game file, downloading what's damaged. Your own addons and settings stay." />
                            </WrapPanel>
                            <TextBlock Text="{Binding RepairStatus}"
                                       IsVisible="{Binding HasRepairStatus}"
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="#E8B64C"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </views:DragonFrame>

                <!-- Realm -->
                <views:DragonFrame Ground="Marble"
                        Padding="16">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Width="42" Height="42"
                                CornerRadius="21"
                                Background="#172330"
                                BorderBrush="#8A6726"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock Text="R"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#F6D477"
                                       FontSize="17"
                                       FontWeight="Bold" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="4">
                            <TextBlock Text="REALM"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#D5AA50" />
                            <TextBlock Text="{Binding RealmName}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="#F8F0DF" />
                            <TextBlock Text="{Binding RealmStatus}"
                                       FontSize="12"
                                       Foreground="#AFA28D"
                                       TextWrapping="Wrap" />
                            <Button Content="CHANGE REALM" Click="ChangeRealm_Click"
                                    IsVisible="{Binding CanChangeRealm}" IsEnabled="{Binding CanSwitchRealm}"
                                    HorizontalAlignment="Left" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </views:DragonFrame>

                <!-- Launch environment -->
                <views:DragonFrame Ground="Marble"
                        Padding="16">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Width="42" Height="42"
                                CornerRadius="21"
                                Background="#172330"
                                BorderBrush="#8A6726"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock Text="L"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#F6D477"
                                       FontSize="17"
                                       FontWeight="Bold" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="4">
                            <TextBlock Text="LAUNCH ENVIRONMENT"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#D5AA50" />
                            <TextBlock Text="{Binding LaunchEnvironmentStatus}"
                                       FontSize="13"
                                       Foreground="#D8CCBA"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </views:DragonFrame>

                <views:DragonFrame Ground="Marble" Padding="16">
                    <StackPanel Spacing="9">
                        <TextBlock Text="{Binding ApplicationVersion}" Foreground="#D5AA50" FontWeight="Bold" />
                        <TextBlock Text="{Binding UpdateStatus}" Foreground="#D8CCBA" TextWrapping="Wrap" />
                        <WrapPanel>
                            <Button Content="CHECK FOR UPDATES" Click="CheckForUpdates_Click" IsEnabled="{Binding CanCheckForUpdates}" Margin="0,0,10,8" />
                            <Button Content="VIEW RELEASE" Click="ViewRelease_Click" IsVisible="{Binding IsUpdateAvailable}" Margin="0,0,0,8" />
                        </WrapPanel>
                        <CheckBox Content="Install Portalkeeper updates automatically"
                                  IsChecked="{Binding AutoUpdatePortalkeeper, Mode=TwoWay}"
                                  IsVisible="{Binding CanUpdateInPlace}"
                                  Foreground="#F2E7D0" />
                    </StackPanel>
                </views:DragonFrame>

                <!-- Behavior -->
                <views:DragonFrame Ground="Marble"
                        Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="BEHAVIOR"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#D5AA50" />
                        <views:DragonFrame Kind="SmallInset" Ground="None"
                                Padding="12,10">
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                <CheckBox Grid.RowSpan="2"
                                          IsChecked="{Binding HidePortalkeeperWhileGameRuns, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0" />
                                <TextBlock Grid.Column="1"
                                           Text="Hide Portalkeeper while World of Warcraft is running"
                                           Foreground="#F2E7D0"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="Portalkeeper will automatically return when the game closes."
                                           Margin="0,4,0,0"
                                           Foreground="#8E9AA5"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </views:DragonFrame>
                        <views:DragonFrame Kind="SmallInset" Ground="None" Padding="12,10"
                                x:Name="TransmogSettingRow" ToolTip.Tip="{Binding TransmogAvailabilityHint}">
                            <CheckBox x:Name="ShowTransmogCheckBox" Content="Show transmogrified appearances"
                                      IsChecked="{Binding ShowTransmogrifiedAppearances, Mode=TwoWay}"
                                      IsEnabled="{Binding TransmogrificationSupported}"
                                      Foreground="#F2E7D0" />
                        </views:DragonFrame>
                    </StackPanel>
                </views:DragonFrame>

                <!-- Account and sharing (Vaultrona fork) -->
                <views:DragonFrame Ground="Marble"
                        Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="ACCOUNT AND SHARING"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#D5AA50" />
                        <views:DragonFrame Kind="SmallInset" Ground="None" Padding="12,10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding AccountSummary}"
                                           Foreground="#F2E7D0"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="LOG OUT" Click="LogOut_Click" />
                            </Grid>
                        </views:DragonFrame>
                        <views:DragonFrame Kind="SmallInset" Ground="None" Padding="12,10">
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                <CheckBox Grid.RowSpan="2"
                                          IsChecked="{Binding ShareDownloads, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0" />
                                <TextBlock Grid.Column="1"
                                           Text="Share downloads with other players while Portalkeeper is open"
                                           Foreground="#F2E7D0"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="Players download the client and patches from each other as well as from the realm. Only files that exactly match the realm's are shared, and sharing pauses while you play."
                                           Margin="0,4,0,0"
                                           Foreground="#8E9AA5"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </views:DragonFrame>
                        <views:DragonFrame Kind="SmallInset" Ground="None" Padding="12,10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock Text="Upload speed limit"
                                           Foreground="#F2E7D0"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1"
                                          MinWidth="140"
                                          ItemsSource="{Binding UploadLimitChoices}"
                                          SelectedIndex="{Binding UploadLimitIndex, Mode=TwoWay}"
                                          IsEnabled="{Binding ShareDownloads}" />
                            </Grid>
                        </views:DragonFrame>
                        <!-- Only when the realm collects combat logs (the portal says so) -->
                        <views:DragonFrame Kind="SmallInset" Ground="None" Padding="12,10"
                                IsVisible="{Binding CombatLogSharingOffered}">
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                                <CheckBox Grid.RowSpan="3"
                                          IsChecked="{Binding ShareCombatLogs, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0" />
                                <TextBlock Grid.Column="1"
                                           Text="Share combat logs with the realm"
                                           Foreground="#F2E7D0"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="Turns combat logging on in dungeons and raids and uploads the log when you close the game. It helps tune the realm's bots. Off by default."
                                           Margin="0,4,0,0"
                                           Foreground="#8E9AA5"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Text="{Binding CombatLogSharingDetail}"
                                           IsVisible="{Binding ShareCombatLogs}"
                                           Margin="0,6,0,0"
                                           Foreground="#E8B64C"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </views:DragonFrame>
                        <!-- Only when the realm takes crash reports (the portal says so) -->
                        <views:DragonFrame Kind="SmallInset" Ground="None" Padding="12,10"
                                IsVisible="{Binding CrashReportsOffered}">
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                <CheckBox Grid.RowSpan="2"
                                          IsChecked="{Binding SendCrashReports, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0" />
                                <TextBlock Grid.Column="1"
                                           Text="Send crash reports without asking"
                                           Foreground="#F2E7D0"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="When World of Warcraft crashes, the error report it wrote goes to the realm so the crash can be looked into. Your Windows user and computer names are taken out first. Off: Portalkeeper asks each time."
                                           Margin="0,4,0,0"
                                           Foreground="#8E9AA5"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </views:DragonFrame>
                    </StackPanel>
                </views:DragonFrame>

                <!-- Isolated runtime (developer test): hidden for players in the Vaultrona build -->
                <Border IsVisible="False"
                        Background="#141018"
                        BorderBrush="#6E3A3A"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="ISOLATED RUNTIME (DEVELOPER TEST)"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#C96A6A" />
                        <TextBlock Text="Experimental construction of an isolated per-realm runtime from the selected source client. It never modifies your source client, never changes Settings.ClientPath, and does not affect normal ENTER REALM launching. Construction is allowed only when the runtime location shares a filesystem with the source client."
                                   Foreground="#B89A9A"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <TextBlock Text="Proposed location:"
                                       Foreground="#8E9AA5"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ProposedRuntimePath}"
                                       Foreground="#F2E7D0"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Text="{Binding RuntimeTestStatus}"
                                   Foreground="#D8CCBA"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                        <WrapPanel Margin="0,4,0,0">
                            <Button Content="CONSTRUCT TEST RUNTIME"
                                    Click="ConstructRuntime_Click"
                                    IsEnabled="{Binding CanConstructRuntime}"
                                    Margin="0,0,10,6" />
                            <Button Content="LAUNCH TEST RUNTIME"
                                    Click="LaunchRuntime_Click"
                                    IsEnabled="{Binding CanLaunchConstructedRuntime}"
                                    Margin="0,0,10,6" />
                            <Button Content="FORGET RUNTIME"
                                    Click="ForgetRuntime_Click"
                                    IsVisible="{Binding ConstructedRuntimePath}"
                                    Margin="0,0,0,6" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="Transparent"
                BorderBrush="#5B431B"
                BorderThickness="0,1,0,0"
                Padding="18,12">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Portalkeeper preferences"
                           VerticalAlignment="Center"
                           Foreground="#756B5C"
                           FontSize="11" />
                <Button Grid.Column="1"
                        Content="CLOSE"
                        Click="Close_Click"
                        Padding="20,9" />
            </Grid>
        </Border>
    </Grid>
    </Panel>
</Window>
