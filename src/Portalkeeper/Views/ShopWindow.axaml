<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Portalkeeper.ViewModels"
        xmlns:views="using:Portalkeeper.Views"
        x:Class="Portalkeeper.Views.ShopWindow"
        x:DataType="vm:ShopViewModel"
        Title="Shop"
        Width="1120" Height="760"
        MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        RequestedThemeVariant="Dark"
        Background="#071019">

    <!-- Evermore fork: the coin shop. Tarnished Undermine Reals from the account's wallet buy mounts,
         companions and character services for one character at a time. -->
    <Window.Resources>
        <!-- Drawn icons for offers without a picture -->
        <StreamGeometry x:Key="HorseshoeIcon">F0 M 3.5,3 L 9,3 L 9.5,12 A 2.5,2.5 0 0 0 14.5,12 L 15,3 L 20.5,3 L 19,12 A 7,7 0 0 1 5,12 Z M 7.3,6 A 0.9,0.9 0 1 0 5.5,6 A 0.9,0.9 0 1 0 7.3,6 Z M 7.7,10 A 0.9,0.9 0 1 0 5.9,10 A 0.9,0.9 0 1 0 7.7,10 Z M 18.5,6 A 0.9,0.9 0 1 0 16.7,6 A 0.9,0.9 0 1 0 18.5,6 Z M 18.1,10 A 0.9,0.9 0 1 0 16.3,10 A 0.9,0.9 0 1 0 18.1,10 Z</StreamGeometry>
        <StreamGeometry x:Key="PawIcon">M 12,12.5 C 8,12.5 5.5,16.5 6.5,19 C 7.5,21.5 10,20.5 12,20.5 C 14,20.5 16.5,21.5 17.5,19 C 18.5,16.5 16,12.5 12,12.5 Z M 5,8.5 A 2,2.5 0 1 0 5,13.5 A 2,2.5 0 1 0 5,8.5 Z M 19,8.5 A 2,2.5 0 1 0 19,13.5 A 2,2.5 0 1 0 19,8.5 Z M 9,3.5 A 2,2.5 0 1 0 9,8.5 A 2,2.5 0 1 0 9,3.5 Z M 15,3.5 A 2,2.5 0 1 0 15,8.5 A 2,2.5 0 1 0 15,3.5 Z</StreamGeometry>
        <StreamGeometry x:Key="SparkleIcon">M 12,2 L 14.2,9.8 L 22,12 L 14.2,14.2 L 12,22 L 9.8,14.2 L 2,12 L 9.8,9.8 Z</StreamGeometry>
        <StreamGeometry x:Key="GemIcon">M 12,3 L 20,10 L 12,21 L 4,10 Z</StreamGeometry>

        <!-- The coin (INV_Misc_Coin_19 in game), drawn: copper with a raised rim. -->
        <DrawingImage x:Key="CoinImage">
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="12,12" RadiusX="11.5" RadiusY="11.5" />
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="38%,32%" GradientOrigin="38%,32%" RadiusX="75%" RadiusY="75%">
                            <GradientStop Offset="0" Color="#FFD3A0" />
                            <GradientStop Offset="0.45" Color="#C9773E" />
                            <GradientStop Offset="1" Color="#6B3214" />
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#4A220C" Thickness="1" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="12,12" RadiusX="8" RadiusY="8" />
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#80FFE2BC" Thickness="1.2" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#AA5A2810" Geometry="M 12,7.2 L 13.3,10.7 L 16.8,12 L 13.3,13.3 L 12,16.8 L 10.7,13.3 L 7.2,12 L 10.7,10.7 Z" />
            </DrawingGroup>
        </DrawingImage>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Background" Value="#CC0B141E" />
            <Setter Property="Foreground" Value="#F6D477" />
            <Setter Property="BorderBrush" Value="#9A6B1E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1B2A38" />
            <Setter Property="BorderBrush" Value="#D2A43A" />
            <Setter Property="Foreground" Value="#FFE9A8" />
        </Style>
        <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#990D1218" />
            <Setter Property="Foreground" Value="#75694E" />
            <Setter Property="BorderBrush" Value="#4E432C" />
        </Style>

        <Style Selector="Button.gold">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#F6D17A" />
                    <GradientStop Offset="0.55" Color="#D9A53E" />
                    <GradientStop Offset="1" Color="#B07C22" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush" Value="#FFE6A3" />
            <Setter Property="Foreground" Value="#2A1A05" />
        </Style>
        <Style Selector="Button.gold:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#FFE29A" />
                    <GradientStop Offset="0.55" Color="#E8B650" />
                    <GradientStop Offset="1" Color="#C08A2C" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush" Value="#FFF2C8" />
            <Setter Property="Foreground" Value="#2A1A05" />
        </Style>
        <Style Selector="Button.gold:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2A2418" />
            <Setter Property="BorderBrush" Value="#4E432C" />
            <Setter Property="Foreground" Value="#75694E" />
        </Style>

        <!-- Category tabs -->
        <Style Selector="Button.tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Foreground" Value="#AFA28D" />
            <Setter Property="FontFamily" Value="avares://Portalkeeper/Assets/Fonts#Cinzel" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#66E8B64C" />
            <Setter Property="Foreground" Value="#FFE9A8" />
        </Style>
        <Style Selector="Button.tab.selected">
            <Setter Property="BorderBrush" Value="#E8B64C" />
            <Setter Property="Foreground" Value="#F6D477" />
        </Style>
        <Style Selector="Button.tab.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="#E8B64C" />
        </Style>
        <!-- Behind the confirm step the tabs stay tabs, only dimmer. -->
        <Style Selector="Button.tab:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#75694E" />
        </Style>
        <Style Selector="Button.tab.selected:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="#9A6B1E" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#0A141D" />
            <Setter Property="Foreground" Value="#E9DFC9" />
            <Setter Property="BorderBrush" Value="#765522" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="#0D1822" />
            <Setter Property="BorderBrush" Value="#4D3B20" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Border.card:pointerover">
            <Setter Property="BorderBrush" Value="#9A6B1E" />
        </Style>

        <!-- Offer tiles: the whole tile picks the offer for the stage -->
        <Style Selector="Button.tile">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#0D1822" />
            <Setter Property="BorderBrush" Value="#4D3B20" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#132231" />
            <Setter Property="BorderBrush" Value="#9A6B1E" />
        </Style>
        <Style Selector="Button.tile:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#17293A" />
        </Style>
        <Style Selector="Button.tile.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1A2A36" />
            <Setter Property="BorderBrush" Value="#E8B64C" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button.tile:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0D1822" />
        </Style>

        <Style Selector="TextBlock.serif">
            <Setter Property="FontFamily" Value="avares://Portalkeeper/Assets/Fonts#Cinzel" />
        </Style>
    </Window.Styles>

    <Grid>
        <Grid RowDefinitions="Auto,Auto,*,Auto" IsEnabled="{Binding !IsConfirming}">

            <!-- Header: title and wallet -->
            <Border Grid.Row="0" BorderBrush="#9A6D25" BorderThickness="0,0,0,2" Padding="30,18">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0" Color="#13283A" />
                        <GradientStop Offset="0.6" Color="#0A141D" />
                        <GradientStop Offset="1" Color="#1E1408" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="18">
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Classes="serif" Text="SHOP" FontSize="32" FontWeight="Bold" LetterSpacing="2">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                    <GradientStop Offset="0" Color="#FFF4CC" />
                                    <GradientStop Offset="0.5" Color="#E8B64C" />
                                    <GradientStop Offset="1" Color="#9C6B1E" />
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                        <TextBlock Text="Spend the coins your bosses dropped. Bring coins to Pix Xizzix to add them to your wallet."
                                   FontSize="12" Foreground="#AFA28D" TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Column="1" IsVisible="{Binding HasBalance}"
                            Background="#B30A121B" BorderBrush="#66E8B64C" BorderThickness="1" CornerRadius="8" Padding="14,8"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Your account's wallet. Every character on the account spends from it.">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Image Source="{StaticResource CoinImage}" Width="34" Height="34" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding BalanceText}" FontSize="24" FontWeight="Bold" Foreground="#F6D477" />
                                <TextBlock Text="{Binding BalanceCaption}" FontSize="11" Foreground="#AFA28D" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="2" Content="REFRESH" Click="Refresh_Click" IsEnabled="{Binding CanRefresh}"
                            VerticalAlignment="Center" Padding="14,8" />
                </Grid>
            </Border>

            <!-- Categories and the character it's for -->
            <Grid Grid.Row="1" Margin="22,10,24,0" ColumnDefinitions="*,Auto" ColumnSpacing="16" IsVisible="{Binding ShowShop}">
                <!-- Wraps to a second line in a narrow window or with many categories. -->
                <ItemsControl ItemsSource="{Binding Categories}" VerticalAlignment="Bottom">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" ItemSpacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ShopCategoryView">
                            <Button Classes="tab" Classes.selected="{Binding IsSelected}" Click="Category_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding Title}" />
                                    <TextBlock Text="{Binding Count}" Foreground="#75694E" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                            IsVisible="{Binding HasCharacters}">
                    <TextBlock Text="Buying for" Foreground="#AFA28D" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}"
                              MinWidth="260" IsEnabled="{Binding !IsBuying}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ShopCharacterView">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Foreground="{Binding ClassBrush}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" Foreground="#AFA28D" FontSize="11" />
                                    </StackPanel>
                                    <Ellipse Grid.Column="1" Width="8" Height="8" Fill="#5CD65C" VerticalAlignment="Center"
                                             IsVisible="{Binding Online}" ToolTip.Tip="In the game now" />
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- Offers -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <!-- Like the retail game's shop: tiles on the left, the picked one large on a stage on the right. -->
                <Grid IsVisible="{Binding ShowShop}" ColumnDefinitions="Auto,*" Margin="22,6,22,16" ColumnSpacing="14">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" Width="{Binding $parent[Window].Bounds.Width, Converter={x:Static views:ShopWindow.TileColumnWidth}}">
                        <StackPanel Spacing="10" Margin="0,0,10,0">
                            <Border IsVisible="{Binding HasNoCharacters}" Classes="card" Padding="16,12">
                                <TextBlock Text="This account has no characters yet. Make one in the game, then come back to buy something for it."
                                           Foreground="#D8CCBA" TextWrapping="Wrap" />
                            </Border>
                            <TextBlock IsVisible="{Binding HasNoOffers}" Text="Nothing is for sale right now."
                                       Foreground="#AFA28D" Margin="4,10" />
                            <ItemsControl ItemsSource="{Binding Offers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="10" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ShopOfferView">
                                        <Button Classes="tile" Classes.selected="{Binding IsSelected}" Click="Tile_Click"
                                                Width="148" Height="184" ToolTip.Tip="{Binding Name}">
                                            <Grid RowDefinitions="*,Auto,Auto" RowSpacing="2">
                                                <Panel Margin="2,4,2,0">
                                                    <!-- The model, turning while the mouse is over it -->
                                                    <views:ShopTurntable Source="{Binding Picture}" Frames="{Binding PictureFrames}"
                                                                         SpinOnHover="True" IsVisible="{Binding !ShowIcon}" />
                                                    <!-- Or a drawn icon -->
                                                    <Border IsVisible="{Binding ShowIcon}" Width="64" Height="64" CornerRadius="32"
                                                            BorderThickness="1.5" BorderBrush="{Binding AccentBrush}" Background="#14202B">
                                                        <Panel Width="34" Height="34" Opacity="0.9">
                                                            <Path IsVisible="{Binding IsMount}" Fill="{Binding AccentBrush}" Stretch="Uniform" Data="{StaticResource HorseshoeIcon}" />
                                                            <Path IsVisible="{Binding IsPet}" Fill="{Binding AccentBrush}" Stretch="Uniform" Data="{StaticResource PawIcon}" />
                                                            <Path IsVisible="{Binding IsService}" Fill="{Binding AccentBrush}" Stretch="Uniform" Data="{StaticResource SparkleIcon}" />
                                                            <Path IsVisible="{Binding IsOther}" Fill="{Binding AccentBrush}" Stretch="Uniform" Data="{StaticResource GemIcon}" />
                                                        </Panel>
                                                    </Border>
                                                </Panel>
                                                <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="#F3D58C"
                                                           TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                                           Margin="6,0" />
                                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" Margin="0,2,0,8">
                                                    <Image Source="{StaticResource CoinImage}" Width="14" Height="14" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding PriceNumber}" FontSize="13" FontWeight="Bold" Foreground="#F6D477" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <Border Grid.RowSpan="3" IsVisible="{Binding IsOwned}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                                                        Background="#2A5CD65C" BorderBrush="#5CD65C" BorderThickness="1" CornerRadius="9" Width="18" Height="18"
                                                        ToolTip.Tip="{Binding StateText}">
                                                    <TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="#8EE68E"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- The stage -->
                    <Border Grid.Column="1" CornerRadius="10" BorderBrush="#4D3B20" BorderThickness="1" ClipToBounds="True"
                            IsVisible="{Binding HasSelectedOffer}">
                        <Border.Background>
                            <RadialGradientBrush Center="50%,40%" GradientOrigin="50%,40%" RadiusX="72%" RadiusY="72%">
                                <GradientStop Offset="0" Color="#2C3E50" />
                                <GradientStop Offset="0.45" Color="#14212D" />
                                <GradientStop Offset="1" Color="#060B10" />
                            </RadialGradientBrush>
                        </Border.Background>
                        <Grid RowDefinitions="*,Auto">
                            <!-- The light on the floor -->
                            <Ellipse Grid.Row="0" Width="380" Height="70" VerticalAlignment="Bottom" Margin="0,0,0,8" IsHitTestVisible="False">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Offset="0" Color="#40E8B64C" />
                                        <GradientStop Offset="1" Color="#00E8B64C" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <views:ShopTurntable Grid.Row="0" Margin="16,16,16,0" Spin="True" Draggable="True"
                                                 Source="{Binding StagePicture}" Frames="{Binding StageFrames}"
                                                 IsVisible="{Binding HasStagePicture}" />
                            <TextBlock Grid.Row="0" Text="Drag to turn" FontSize="11" Foreground="#80AFA28D" Margin="0,12,16,0"
                                       HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="{Binding HasStagePicture}" IsHitTestVisible="False" />
                            <ProgressBar Grid.Row="0" IsVisible="{Binding IsStageLoading}" IsIndeterminate="True" Width="120" Height="3"
                                         Foreground="#E8B64C" Background="#26FFFFFF" VerticalAlignment="Bottom" Margin="0,0,0,24" />

                            <!-- No picture: the icon, glowing -->
                            <Panel Grid.Row="0" IsVisible="{Binding ShowStageIcon}" Width="220" Height="220" IsHitTestVisible="False">
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Offset="0" Color="#66E8B64C" />
                                            <GradientStop Offset="0.55" Color="#1AE8B64C" />
                                            <GradientStop Offset="1" Color="#00E8B64C" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Border Width="120" Height="120" CornerRadius="60" BorderThickness="3"
                                        BorderBrush="{Binding SelectedOffer.AccentBrush}" Background="#14202B">
                                    <Panel Width="62" Height="62">
                                        <Path IsVisible="{Binding SelectedOffer.IsMount}" Fill="{Binding SelectedOffer.AccentBrush}" Stretch="Uniform" Data="{StaticResource HorseshoeIcon}" />
                                        <Path IsVisible="{Binding SelectedOffer.IsPet}" Fill="{Binding SelectedOffer.AccentBrush}" Stretch="Uniform" Data="{StaticResource PawIcon}" />
                                        <Path IsVisible="{Binding SelectedOffer.IsService}" Fill="{Binding SelectedOffer.AccentBrush}" Stretch="Uniform" Data="{StaticResource SparkleIcon}" />
                                        <Path IsVisible="{Binding SelectedOffer.IsOther}" Fill="{Binding SelectedOffer.AccentBrush}" Stretch="Uniform" Data="{StaticResource GemIcon}" />
                                    </Panel>
                                </Border>
                            </Panel>

                            <!-- What it is and BUY -->
                            <Border Grid.Row="1" Margin="14,4,14,14" Padding="18,14" CornerRadius="8"
                                    Background="#E60A121B" BorderBrush="#9A6B1E" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <TextBlock Classes="serif" Text="{Binding SelectedOffer.Name}" FontSize="20" FontWeight="Bold" Foreground="#F3D58C"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Classes="serif" Text="{Binding SelectedOffer.CategoryTitle}" FontSize="11"
                                                   Foreground="{Binding SelectedOffer.AccentBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="{Binding SelectedOffer.Description}" FontSize="12.5" Foreground="#C9BCA6"
                                               TextWrapping="Wrap" MaxLines="3" TextTrimming="WordEllipsis" ToolTip.Tip="{Binding SelectedOffer.Description}" />
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,4,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                            <Image Source="{StaticResource CoinImage}" Width="22" Height="22" />
                                            <TextBlock Text="{Binding SelectedOffer.PriceNumber}" FontSize="20" FontWeight="Bold" Foreground="#F6D477" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedOffer.StateText}" IsVisible="{Binding SelectedOffer.HasState}"
                                                   Foreground="#C9A27A" FontSize="12.5" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="2" Classes="gold" Content="BUY" Click="Buy_Click"
                                                IsEnabled="{Binding SelectedOffer.CanBuy}" Padding="26,8" FontSize="14" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- First load -->
                <StackPanel IsVisible="{Binding ShowFirstLoad}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Width="260">
                    <TextBlock Text="Opening the shop..." Foreground="#D8CCBA" HorizontalAlignment="Center" />
                    <ProgressBar IsIndeterminate="True" Height="3" Foreground="#E8B64C" Background="#26FFFFFF" />
                </StackPanel>

                <!-- No listing -->
                <Border IsVisible="{Binding HasLoadError}" Classes="card" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="520" Padding="24,20">
                    <StackPanel Spacing="14">
                        <TextBlock Text="The shop isn't available" Classes="serif" FontSize="18" FontWeight="Bold" Foreground="#F3D58C"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding LoadError}" Foreground="#D8CCBA" TextWrapping="Wrap" TextAlignment="Center" />
                        <Button Content="TRY AGAIN" Click="Refresh_Click" IsEnabled="{Binding CanRefresh}" HorizontalAlignment="Center" Padding="16,8" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Status line: what the last purchase did -->
            <Border Grid.Row="3" Background="#0A121B" BorderBrush="#33FFFFFF" BorderThickness="0,1,0,0" Padding="24,10"
                    IsVisible="{Binding HasStatus}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <ProgressBar Width="60" Height="3" IsIndeterminate="True" Foreground="#E8B64C" Background="#26FFFFFF"
                                 VerticalAlignment="Center" IsVisible="{Binding IsBuying}" />
                    <Grid Grid.Column="1">
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#8EE68E" IsVisible="{Binding !StatusIsError}" />
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#E58A73" IsVisible="{Binding StatusIsError}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Confirm step -->
        <Grid Background="#B3040709" IsVisible="{Binding IsConfirming}">
            <Border Width="460" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#F20A121B" BorderBrush="#9A6B1E" BorderThickness="1" CornerRadius="10" Padding="26,22">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <Image Source="{StaticResource CoinImage}" Width="26" Height="26" />
                        <TextBlock Classes="serif" Text="CONFIRM PURCHASE" FontSize="18" FontWeight="Bold" Foreground="#F3D58C" VerticalAlignment="Center" />
                    </StackPanel>
                    <views:ShopTurntable Height="150" Spin="True" Source="{Binding PendingOffer.Picture}" Frames="{Binding PendingOffer.PictureFrames}"
                                         IsVisible="{Binding PendingOffer.Picture, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Text="{Binding ConfirmText}" FontSize="15" Foreground="#F6EBD2" TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBlock Text="{Binding ConfirmDetail}" FontSize="12" Foreground="#AFA28D" TextWrapping="Wrap" TextAlignment="Center" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,6,0,0">
                        <Button x:Name="CancelBuyButton" Content="CANCEL" Click="CancelBuy_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,9" />
                        <Button Grid.Column="1" Classes="gold" Content="BUY" Click="ConfirmBuy_Click"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,9" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
